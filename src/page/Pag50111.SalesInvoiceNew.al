    RefreshOnActivate = true;
    SourceTable = "Sales Header";
    SourceTableView = where("Document Type" = filter(Invoice));
    ApplicationArea = All; //
    UsageCategory = None; //Upgrade OP Code

    layout
    {
        area(content)
        {
            group(General)
            {
